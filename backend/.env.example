APP_NAME="WSDC Klinik API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL 15+) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wsdc_klinik
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Disk aktif: "local"/"public" untuk dev, "r2" untuk production.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@wsdc.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Laravel Sanctum (Bearer Token / Personal Access Token) ---
# Domain frontend React untuk stateful SPA (opsional; proyek ini memakai Bearer token).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173
# Masa berlaku token dalam menit (kosong = tidak kedaluwarsa). Mis. 43200 = 30 hari.
SANCTUM_TOKEN_EXPIRATION=

# --- Cloudflare R2 (S3-compatible object storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Public base URL bucket (kosongkan bila memakai signed URL).
AWS_URL=

# --- Media / dokumen ---
# Masa berlaku signed URL foto medis (menit).
MEDIA_SIGNED_URL_TTL=30
# Ukuran maksimum upload foto (KB).
MEDIA_MAX_UPLOAD_KB=5120

VITE_APP_NAME="${APP_NAME}"
